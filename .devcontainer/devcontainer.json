{
  "name": "Pre-Watch",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Pre-Watch (open /app/)", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm install",
  "postAttachCommand": "npm start",
  "containerEnv": {
    "PORT": "3000"
  }
}
